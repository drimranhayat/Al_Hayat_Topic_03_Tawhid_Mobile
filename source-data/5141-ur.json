646\u0647 \u0645\u0642\u062a\u0636\u0649 \u0627\u0644\u062a\u0631\u0628\u064a\u0629\u060c \u0648\u0641\u064a\u0647 \u0627\u0644\u062a\u0647\u0644\u064a\u0644 \u0627\u0644\u0645\u0634\u062a\u0645\u0644 \u0639\u0644\u0649 \u0627\u0644\u062a\u0648\u062d\u064a\u062f \u0648\u0647\u0648 \u0623\u0635\u0644 \u0627\u0644\u062a\u0646\u0632\u064a\u0647\u0627\u062a \u0627\u0644\u062c\u0644\u0627\u0644\u064a\u0629\u060c \u0648\u0627\u0644\u0639\u0638\u0645\u0629 \u0627\u0644\u062a\u064a \u062a\u062f\u0644 \u0639\u0644\u0649 \u062a\u0645\u0627\u0645 \u0627\u0644\u0642\u062f\u0631\u0629\u060c \u0648\u0627\u0644\u062d\u0644\u0645 \u0627\u0644\u0630\u064a \u064a\u062f\u0644 \u0639\u0644\u0649 \u0627\u0644\u0639\u0644\u0645\u060c \u0625\u0630 \u0627\u0644\u062c\u0627\u0647\u0644 \u0644\u0627 \u064a\u064f\u062a\u064e\u0635\u064e\u0648\u0651\u0631 \u0645\u0646\u0647 \u062d\u0650\u0644\u0652\u0645 \u0648\u0644\u0627 \u0643\u0631\u0645 \u0648\u0647\u0645\u0627 \u0623\u0635\u0644 \u0627\u0644\u0623\u0648\u0635\u0627\u0641 \u0627\u0644\u0625\u0643\u0631\u0627\u0645\u064a\u0629."],"words_meanings_ar":[],"attribution_ar":"\u0645\u062a\u0641\u0642 \u0639\u0644\u064a\u0647","grade_ar":"\u0635\u062d\u064a\u062d"}