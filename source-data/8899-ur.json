62a\u0649 \u0623\u0644\u0642\u064a \u0641\u064a \u0627\u0644\u0646\u0627\u0631. \u0648\u0631\u062c\u0644 \u0648\u064e\u0633\u0651\u064e\u0639\u064e \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647\u060c \u0648\u0623\u0639\u0637\u0627\u0647 \u0645\u0646 \u0623\u0635\u0646\u0627\u0641 \u0627\u0644\u0645\u0627\u0644\u060c \u0641\u0623\u064f\u062a\u064a \u0628\u0647 \u0641\u0639\u0631\u0651\u064e\u0641\u0647 \u0646\u0650\u0639\u064e\u0645\u0647\u060c \u0641\u0639\u0631\u064e\u0641\u064e\u0647\u0627. \u0642\u0627\u0644: \u0641\u0645\u0627 \u0639\u0645\u0644\u062a \u0641\u064a\u0647\u0627\u061f \u0642\u0627\u0644: \u0645\u0627 \u062a\u0631\u0643\u062a \u0645\u0646 \u0633\u0628\u064a\u0644 \u062a\u064f\u062d\u0650\u0628\u0651\u064f \u0623\u0646 \u064a\u064f\u0646\u0652\u0641\u064e\u0642\u064e \u0641\u064a\u0647\u0627 \u0625\u0644\u0627 \u0623\u0646\u0641\u0642\u062a \u0641\u064a\u0647\u0627 \u0644\u0643. \u0642\u0627\u0644: \u0643\u064e\u0630\u064e\u0628\u0652\u062a\u064e\u060c \u0648\u0644\u0643\u0646\u0643 \u0641\u0639\u0644\u062a \u0644\u064a\u0642\u0627\u0644: \u062c\u0648\u0627\u062f! \u0641\u0642\u062f \u0642\u064a\u0644\u060c \u062b\u0645 \u0623\u064f\u0645\u0650\u0631 \u0628\u0647 \u0641\u064e\u0633\u064f\u062d\u0650\u0628 \u0639\u0644\u0649 \u0648\u062c\u0647\u0647 \u062d\u062a\u0649 \u0623\u0644\u0642\u064a \u0641\u064a \u0627\u0644\u0646\u0627\u0631\u00bb.","explanation_ar":"\u0623\u0646 \u0623\u0648\u0644 \u0645\u0646 \u064a\u064f\u0642\u0636\u064a \u0641\u064a\u0647\u0645 \u064a\u0648\u0645 \u0627\u0644\u0642\u064a\u0627\u0645\u0629 \u0647\u0645 \u062b\u0644\u0627\u062b\u0629 \u0623\u0635\u0646\u0627\u0641: \u0645\u064f\u062a\u064e\u0639\u0644\u0651\u0650\u0645 \u0645\u0631\u0627\u0626\u064a \u0648\u0645\u0642\u0627\u062a\u0644 \u0645\u0631\u0627\u0626\u064a \u0648\u0645\u062a\u0635\u062f\u0651\u0650\u0642 \u0645\u0631\u0627\u0626\u064a\u060c \u062b\u0645 \u0625\u0646 \u0627\u0644\u0644\u0647 \u0633\u0628\u062d\u0627\u0646\u0647 \u0648\u062a\u0639\u0627\u0644\u0649 \u064a\u0623\u062a\u0649 \u0628\u0647\u0645 \u0625\u0644\u064a\u0647 \u064a\u0648\u0645 \u0627\u0644\u0642\u064a\u0627\u0645\u0629 \u0641\u064a\u0639\u0631\u0641\u0647\u0645 \u0627\u0644\u0644\u0647 \u0646\u0639\u0645\u062a\u0647 \u0641\u064a\u0639\u0631\u0641\u0648\u0646\u0647\u0627 \u0648\u064a\u0639\u062a\u0631\u0641\u0648\u0646 \u0628\u0647\u0627 \u0641\u064a\u0633\u0623\u0644 \u0643\u0644 \u0645\u0646\u0647\u0645: \u0645\u0627\u0630\u0627 \u0635\u0646\u0639\u062a\u061f \u064a\u0639\u0646\u064a \u0641\u064a \u0634\u0643\u0631 \u0647\u0630\u0647 \u0627\u0644\u0646\u0639\u0645\u0629\u060c \u0641\u064a\u0642\u0648\u0644 \u0627\u0644\u0623\u0648\u0644: \u062a\u0639\u0644\u0645\u062a \u0627\u0644\u0639\u0644\u0645 \u0648\u0642\u0631\u0623\u062a \u0627\u0644\u0642\u0631\u0622\u0646 \u0641\u064a\u0643. \u0641\u0642\u0627\u0644 \u0627\u0644\u0644\u0647 \u0644\u0647: \u0643\u0630\u0628\u062a\u060c \u0648\u0644\u0643\u0646 \u062a\u0639\u0644\u0645\u062a \u0644\u064a\u0642\u0627\u0644: \u0639\u0627\u0644\u0645\u060c \u0648\u0642\u0631\u0623\u062a \u0627\u0644\u0642\u0631\u0622\u0646 \u0644\u064a\u0642\u0627\u0644: \u0642\u0627\u0631\u0626 \u0644\u064a\u0633 \u0644\u0644\u0647\u060c \u0628\u0644 \u0644\u0623\u062c\u0644 \u0627\u0644\u0631\u064a\u0627\u0621\u060c \u062b\u0645 \u0623\u064f\u0645\u0631 \u0628\u0647 \u0641\u0633\u064f\u062d\u0628 \u0639\u0644\u0649 \u0648\u062c\u0647\u0647 \u0641\u064a \u0627\u0644\u0646\u0627\u0631\u060c \u0648\u0643\u0630\u0627 \u0645\u0646 \u0628\u0639\u062f\u0647.","hints_ar":["\u0627\u0644\u062a\u062d\u0630\u064a\u0631 \u0645\u0646 \u0627\u0644\u0631\u064a\u0627\u0621\u060c \u0648\u0623\u0646 \u0623\u0648\u0644 \u0645\u0627 \u064a\u0642\u0636\u0649 \u0641\u064a\u0647 \u064a\u0648\u0645 \u0627\u0644\u0642\u064a\u0627\u0645\u0629 \u0623\u0639\u0645\u0627\u0644 \u0627\u0644\u0631\u064a\u0627\u0621 \u0628\u0625\u0638\u0647\u0627\u0631\u0647\u0627 \u0648\u062a\u0623\u0646\u064a\u0628 \u0623\u0635\u062d\u0627\u0628\u0647\u0627 \u0648\u0641\u0636\u062d\u0647\u0645.","\u062a\u063a\u0644\u064a\u0638 \u062a\u062d\u0631\u064a\u0645 \u0627\u0644\u0631\u0651\u0650\u064a\u0627\u0621 \u0648\u0634\u062f\u0651\u0650\u0629 \u0627\u0644\u0639\u0642\u0648\u0628\u0629 \u0639\u0644\u064a\u0647.","\u0644\u0627 \u064a\u0643\u0641\u064a \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u0638\u0627\u0647\u0631 \u0644\u0644\u0646\u062c\u0627\u0629 \u0641\u064a \u0627\u0644\u0622\u062e\u0631\u0629\u060c \u0628\u0644 \u0644\u0627 \u0628\u062f \u0645\u0646 \u0627\u0644\u0625\u062e\u0644\u0627\u0635 \u0648\u0627\u0628\u062a\u063a\u0627\u0621 \u0648\u062c\u0647 \u0627\u0644\u0644\u0647 -\u062a\u0639\u0627\u0644\u0649-.","\u0627\u0644\u0645\u0631\u0627\u0624\u0648\u0646 \u064a\u0623\u062e\u0630\u0648\u0646 \u062b\u0648\u0627\u0628\u0647\u0645 \u0641\u064a \u0627\u0644\u062f\u0646\u064a\u0627 \u0641\u0642\u0637 \u0648\u0647\u0648 \u0645\u062f\u062d \u0627\u0644\u0646\u0627\u0633 \u0644\u0647\u0645.","\u0627\u0644\u0645\u0631\u0627\u0624\u0648\u0646 \u064a\u0648\u0645 \u0627\u0644\u0642\u064a\u0627\u0645\u0629 \u0644\u0627 \u064a\u062c\u062f\u0648\u0646 \u0625\u0644\u0627 \u0627\u0644\u0639\u0630\u0627\u0628 \u062c\u0632\u0627\u0621 \u0648\u0641\u0627\u0642\u064b\u0627 \u0644\u0647\u0645.","\u0627\u0645\u062a\u0647\u0627\u0646 \u0648\u0625\u0630\u0644\u0627\u0644 \u0644\u0644\u0645\u0631\u0627\u0626\u064a\u0646\u061b \u0644\u0623\u0646\u0647\u0645 \u064a\u0633\u062d\u0628\u0648\u0646 \u0639\u0644\u0649 \u0648\u062c\u0648\u0647\u0647\u0645 \u0645\u0648\u0636\u0639 \u0643\u0631\u0627\u0645\u062a\u0647\u0645 \u0625\u0644\u0649 \u0627\u0644\u0646\u0627\u0631.","\u0648\u062c\u0648\u0628 \u0625\u062e\u0644\u0627\u0635 \u0627\u0644\u0639\u0645\u0644 \u0644\u0644\u0647 -\u062a\u0639\u0627\u0644\u0649-."],"words_meanings_ar":[{"word":"\u064a\u064f\u0642\u0636\u0649 \u064a\u0648\u0645 \u0627\u0644\u0642\u064a\u0627\u0645\u0629 \u0639\u0644\u064a\u0647","meaning":" \u064a\u062d\u0643\u0645 \u0639\u0644\u064a\u0647 \u0648\u064a\u0641\u0635\u0644 \u0641\u064a \u0623\u0645\u0631\u0647."},{"word":"\u0639\u0631\u0651\u064e\u0641\u0647 \u0646\u0650\u0639\u0645\u062a\u0647","meaning":" \u0639\u0631\u0651\u064e\u0641 \u0627\u0644\u0644\u0647 \u0627\u0644\u0639\u0628\u062f \u0646\u0650\u0639\u0645\u062a\u0647 \u0627\u0644\u062a\u064a \u0643\u0627\u0646\u062a \u0639\u0644\u064a\u0647 \u0641\u064a \u0627\u0644\u062f\u0646\u064a\u0627."},{"word":"\u0642\u064e\u0627\u062a\u064e\u0644\u0652\u062a \u0641\u064a\u0643","meaning":" \u0623\u064a \u0644\u0623\u062c\u0644\u0643 \u0648\u0644\u0646\u064e\u0635\u0631 \u062f\u0650\u064a\u0646\u0643."},{"word":"\u0641\u0642\u062f \u0642\u0650\u064a\u0644","meaning":" \u0623\u064a \u062d\u0635\u0644 \u0644\u0643 \u0641\u064a \u0627\u0644\u062f\u0646\u064a\u0627 \u0645\u0627 \u0623\u0631\u062f\u062a."},{"word":"\u0641\u064e\u0633\u064f\u062d\u0650\u0628","meaning":" \u062c\u064f\u0631\u0651\u064e."},{"word":"\u062c\u064e\u0648\u0627\u062f","meaning":" \u0643\u062b\u064a\u0631 \u0627\u0644\u062c\u064f\u0648\u062f \u0648\u0627\u0644\u0639\u0637\u0627\u0621."}],"attribution_ar":"\u0631\u0648\u0627\u0647 \u0645\u0633\u0644\u0645","grade_ar":"\u0635\u062d\u064a\u062d"}